# Copy values into .env.development / .env.production as needed.
# Put your real API key only in .env.local (gitignored). Never commit secrets.

# Real API host (for documentation / non-proxy deployments):
#   https://api.restcountries.com/countries/v5
# Local dev and preview use the Vite proxy path below so the browser
# stays same-origin and the Authorization header is injected server-side
# (the API key's CORS allowlist blocks Origin http://localhost:5173).
VITE_API_BASE_URL=/api/countries/v5
VITE_APP_ENV=development

# Required for npm run dev / preview. Get a key at https://restcountries.com/sign-up
# Warning: any VITE_ variable is exposed in the client bundle. Do not deploy
# a build that embeds a real key to a public host.
VITE_API_KEY=
